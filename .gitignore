# Encrypted documents — never commit user data.
# A saved vault is an .html carrying its own ciphertext, so ignore every .html at the
# repo root and re-admit only the blank template.
/*.html
!/index.html
*.sectxt

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Tooling / local servers
node_modules/
.cache/
__pycache__/
*.pyc
